# Copia este archivo a .env (que git ignora) y pon tus valores. El .env nunca se sube a git.
# Las variables del sistema tienen prioridad sobre este archivo.

# URL JDBC de PostgreSQL; por defecto, la base local de docker compose.
DB_URL=jdbc:postgresql://localhost:5432/gimnasio
# Usuario de la base; docker compose crea este mismo usuario.
DB_USER=gimnasio
# Contraseña de desarrollo. La usan la app y docker-compose.yml (al crear la base por primera vez). Obligatoria.
DB_PASSWORD=cambia-esta-contraseña

# Primer administrador: solo se usa si la base no tiene usuarios. Después puedes borrar estas líneas.
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin
# De al menos 8 caracteres; cámbiala después del primer acceso.
ADMIN_PASSWORD=cambia-esta-contraseña
