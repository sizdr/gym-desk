// Modelo de datos del sistema de gestión de gimnasio (PostgreSQL 16).
// Corresponde con las migraciones V1 a V5 de src/main/resources/db/migration.
// Alcance: socios, planes, métodos de pago, usuarios y cobro de membresías.

Enum rol_usuario {
  administrador
  recepcion
  caja
}

Enum tipo_cobro {
  primera [note: 'Primera membresía del socio']
  renovacion_anticipada [note: 'Renueva antes de vencer: empieza al terminar la vigente']
  renovacion_vencida [note: 'Renueva ya vencida, antes de la baja: empieza el día del cobro']
  reactivacion [note: 'Vuelve después de la baja: empieza el día del cobro']
}

Table configuracion {
  id smallint [pk, default: 1]
  nombre_gimnasio varchar(100) [not null]
  direccion varchar(200)
  telefono varchar(30)
  logotipo bytea [note: 'PNG o JPG']
  leyenda_recibo varchar(160)
  moneda char(3) [not null, default: 'MXN', note: 'No se cambia si ya hay cobros']
  dias_aviso integer [not null, default: 7]
  dias_baja_automatica integer [not null, default: 30, note: 'Cambiarlo recalcula las bajas anteriores']

  Note: 'Una sola fila. CHECK (id = 1), dias_aviso BETWEEN 1 AND 60, dias_baja_automatica BETWEEN 1 AND 365.'
}

Table folio_secuencia {
  serie varchar(10) [pk, note: "Solo 'COBRO'"]
  prefijo varchar(20) [not null, note: 'CHECK prefijo ~ ^[A-Z0-9-]{1,8}$']
  ultimo bigint [not null, default: 0]
  ancho smallint [not null, default: 4]

  Note: 'El folio se toma con UPDATE ... SET ultimo = ultimo + 1 RETURNING, en la transacción del cobro. Nunca MAX()+1.'
}

Table usuario {
  id bigint [pk, increment]
  nombre varchar(100) [not null]
  nombre_usuario varchar(50) [not null, note: 'Con este se entra']
  contrasena_hash varchar(255) [not null, note: 'Argon2id']
  rol rol_usuario [not null]
  activo boolean [not null, default: true]

  Indexes {
    nombre_usuario [unique, note: 'En PostgreSQL: UNIQUE (lower(nombre_usuario))']
  }
}

Table plan_membresia {
  id bigint [pk, increment]
  nombre varchar(60) [not null]
  duracion_dias integer [not null]
  precio numeric(12,2) [not null]
  activo boolean [not null, default: true]
  referencia_mensual_id bigint [ref: > plan_membresia.id, note: 'Plan de 30 días contra el que se calcula el ahorro; opcional']

  Indexes {
    nombre [unique, note: 'En PostgreSQL: UNIQUE (lower(nombre))']
  }

  Note: 'CHECK duracion_dias BETWEEN 1 AND 730, precio > 0, referencia_mensual_id <> id. Los descuentos son planes propios.'
}

Table metodo_pago {
  id bigint [pk, increment]
  nombre varchar(40) [not null]
  es_efectivo boolean [not null, default: false, note: 'Si es efectivo se pide lo recibido y se calcula el cambio']
  activo boolean [not null, default: true]

  Indexes {
    nombre [unique, note: 'En PostgreSQL: UNIQUE (lower(nombre))']
  }
}

Table socio {
  id bigint [pk, increment]
  nombre varchar(100) [not null]
  telefono char(10) [not null]
  correo varchar(120) [note: 'Opcional']
  fecha_alta date [not null]

  Indexes {
    correo [unique, note: 'En PostgreSQL: UNIQUE (lower(correo)) WHERE correo IS NOT NULL']
    nombre [note: 'En PostgreSQL: GIN con pg_trgm para coincidencias parciales']
    telefono
  }

  Note: 'CHECK telefono ~ ^[0-9]{10}$. El estado y las bajas NO se guardan: se derivan de las membresías, dias_aviso y dias_baja_automatica.'
}

Table pago {
  id bigint [pk, increment]
  folio varchar(30) [not null, unique, note: 'Texto ya formado, por ejemplo GYM-0001']
  socio_id bigint [not null, ref: > socio.id]
  usuario_id bigint [not null, ref: > usuario.id, note: 'Quién atendió']
  metodo_pago_id bigint [not null, ref: > metodo_pago.id]
  monto numeric(12,2) [not null, note: 'Precio del plan en ese momento']
  efectivo_recibido numeric(12,2) [note: 'Solo en efectivo; cambio = recibido - monto']
  fecha_hora timestamptz [not null, default: `now()`]
  tipo_cobro tipo_cobro [not null, note: 'Lo que fue el cobro en su momento']
  operacion_id varchar(64) [unique, note: 'Lo genera la UI; un segundo envío no cobra dos veces']

  Indexes {
    (id, socio_id) [unique, note: 'Para la clave compuesta de membresia']
    (socio_id, fecha_hora)
    fecha_hora
  }

  Note: 'CHECK monto >= 0, efectivo_recibido >= monto.'
}

Table membresia {
  id bigint [pk, increment]
  socio_id bigint [not null]
  plan_id bigint [not null, ref: > plan_membresia.id]
  pago_id bigint [not null, unique, note: 'Un pago, una membresía']
  fecha_inicio date [not null]
  fecha_vencimiento date [not null]

  Indexes {
    (socio_id, fecha_vencimiento)
  }

  Note: 'Historial: se crea al cobrar. La vigente es la de vencimiento más reciente. CHECK fecha_vencimiento > fecha_inicio. Al cobrar se bloquea la fila del socio con SELECT ... FOR UPDATE.'
}

Ref: membresia.(pago_id, socio_id) > pago.(id, socio_id)
